{
  "opencollection": "1.0.0",
  "info": {
    "name": "fastFOREX.io admin API",
    "version": "2.3.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastforex.io/usage"
          },
          "docs": "Fetch recent API usage data. Includes current period start, end, usage and quota remaining"
        }
      ]
    }
  ],
  "bundled": true
}